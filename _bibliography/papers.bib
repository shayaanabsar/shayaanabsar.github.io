@inproceedings{absar2025finetuning,
  abbr        = {RESOURCEFUL},
  bibtex_show = {true},
  title       = {Fine-Tuning Cross-Lingual LLMs for POS Tagging in Code-Switched Contexts},
  author      = {Absar, Shayaan},
  booktitle   = {Proceedings of the Third Workshop on Resources and Representations for Under-Resourced Languages and Domains (RESOURCEFUL-2025)},
  year        = {2025},
  publisher   = {Association for Computational Linguistics},
  selected    = {true},
  abstract    = {Investigates fine-tuning multilingual models (such as XLM-RoBERTa) for part-of-speech tagging in code-switched text across Indian languages and English. Introduces the S-Index, a novel metric designed to quantify language-switching intensity, and demonstrates that cross-lingual models generalize effectively to unseen language pairs even in low-resource settings.}
}

@inproceedings{absar2023crosslingual,
  abbr        = {NLP4TIA},
  bibtex_show = {true},
  title       = {Cross-Lingual Idiom Sense Clustering in German and English},
  author      = {Absar, Muhammad Shayaan},
  booktitle   = {Proceedings of the First Workshop on NLP Tools and Resources for Translation and Interpreting Applications (NLP4TIA)},
  year        = {2023},
  publisher   = {Association for Computational Linguistics},
  selected    = {true},
  abstract    = {Develops an idiom sense clustering system utilizing multilingual transformer embeddings fine-tuned with contrastive learning across German and English. Evaluates on a dataset of 14,000 idioms with a novel sense-based representation learning methodology, showing that fine-tuned cross-lingual representations significantly outperform standard baseline approaches.}
}
